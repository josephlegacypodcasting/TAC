# Copy to .env.local and fill in as needed.

# When to ask for contact details: "first" (before the questions, default),
# "last" (after the questions, before the result) or "off".
NEXT_PUBLIC_GATE_MODE=first

# GHL booking widget URL (Calendars → Share → Permanent link), e.g.
# https://api.leadconnectorhq.com/widget/booking/<calendarId>
# When set, the calendar is embedded on the result page, prefilled with
# the contact's name, email and company, and the CTA button scrolls to it.
NEXT_PUBLIC_TAC_CALENDAR_URL=

# Fallback link for the CTA when no calendar is embedded.
# Defaults to a mailto: link to Kieran Cleary.
NEXT_PUBLIC_TAC_CTA_URL=

# Webhook that receives leads and completed assessments as JSON
# (e.g. a GoHighLevel workflow "Inbound Webhook" trigger URL).
# When empty, payloads are only logged to the server console.
LEAD_WEBHOOK_URL=
